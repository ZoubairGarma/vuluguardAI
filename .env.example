KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_SCAN_REQUESTS=scan-requests
KAFKA_GROUP_ID=vulnguard-scan-consumer
KAFKA_MAX_POLL_INTERVAL_MS=900000

# Local LLM (Ollama) used for vulnerability explanations
OLLAMA_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434
# Context window in tokens. Ollama's default is too small for these prompts
# and silently drops the start of the prompt when it overflows.
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT=600
OLLAMA_TEMPERATURE=0.1
OLLAMA_SEED=42
